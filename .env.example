# ==============================================================================
# RAVAN College Receptionist & Visitor Appointment Management System
# Production Environment Configuration Template
# ==============================================================================

# Network & Server Port
PORT=5000
NODE_ENV=production

# Public URLs (Used for CORS and QR code token verification links)
# In production, change this to your domain or server IP (e.g. https://reception.college.edu)
APP_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5000,http://localhost:5173

# Database Connection URL
# Option A (SQLite - Default Zero-Config):
DATABASE_URL="file:./dev.db"
# Option B (PostgreSQL - High Volume / Enterprise):
# DATABASE_URL="postgresql://ravan_admin:ravan_secure_pass_2026@localhost:5432/ravan_reception?schema=public"

# Security & Encryption Secrets (Generate random 32+ character strings for production)
JWT_SECRET=production-secret-jwt-key-ravan-2026-min-32-chars-replace-me
SESSION_SECRET=production-session-key-ravan-reception-2026-replace-me

# Google Gemini AI Integration (Required for Grounded AI Receptionist)
# Obtain your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Private Visitor Photo Storage Vault
STORAGE_DRIVER=local
STORAGE_UPLOAD_DIR=../../uploads/visitor-photos

# Default Institution Identity (Also editable live from Admin Dashboard)
DEFAULT_COLLEGE_NAME="RAVAN College Receptionist"
DEFAULT_COLLEGE_TAGLINE="AI Visitor & Appointment Management System"
DEFAULT_LANGUAGE=en
